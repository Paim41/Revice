{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ownerUid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "reading": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sequenceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "battery": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "percentage": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "charging": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "temperatureC": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 150
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "voltageMv": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "health": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 40
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cycleCount": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "percentage",
                "charging"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "storage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "totalBytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "availableBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "totalBytes",
                "availableBytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "system": {
          "type": "object",
          "properties": {
            "cpuPercent": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "ramTotalBytes": {
              "type": "number",
              "minimum": 0
            },
            "ramUsedBytes": {
              "type": "number",
              "minimum": 0
            },
            "uptimeSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "sequenceId",
        "observedAt",
        "agentVersion",
        "battery",
        "storage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ownerUid",
    "deviceId",
    "reading"
  ],
  "additionalProperties": false,
  "$comment": "Agent ingestion envelope. Runtime additionally validates availableBytes <= totalBytes, time skew, credentials and sequence replay. receivedAt is server-generated."
}
