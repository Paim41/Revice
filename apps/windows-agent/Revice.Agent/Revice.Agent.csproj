<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.2.3</Version>
    <FileVersion>0.2.3.0</FileVersion>
    <ApplicationIcon>../../../branding/revice.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\branding\revice-app-icon.png" LogicalName="Revice.AppIcon.png" />
    <EmbeddedResource Include="../../../branding/revice-header-logo.png" LogicalName="Revice.Header.png" />
    <EmbeddedResource Include="../../../branding/revice.ico" LogicalName="Revice.Icon.ico" />
  </ItemGroup>
</Project>
